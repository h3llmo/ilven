# Ilven compose defaults. No secrets here: all secrets are generated inside the stack on first start.
COMPOSE_PROJECT_NAME=ilven
# Dev: platform + Keycloak. To grant container management to Nevli (optional, root-equivalent), append :compose.docker.yaml
# Prod (Cloudflare Access): COMPOSE_FILE=compose.yaml, ILVEN_AUTH_MODE=cloudflare and set CF_ACCESS_TEAM_DOMAIN / CF_ACCESS_AUD.
COMPOSE_FILE=compose.yaml:compose.dev.yaml

ILVEN_HTTP_PORT=8080
# Local URL (also the only origin allowed to reach the Keycloak admin console).
ILVEN_PUBLIC_URL=http://localhost:8080
# Public hosts: https://ilven-<name>.<domain> for each name (exposed through the Cloudflare tunnel, no Access policy).
ILVEN_PUBLIC_DOMAIN=home-warlock.com
ILVEN_PUBLIC_HOSTS=auth account admin pilot
# Integrated systems keep their own name: https://<name>.<domain> (e.g. locke-vault).
ILVEN_APP_HOSTS=locke-vault
# The single public URL of the identity provider (token issuer).
ILVEN_AUTH_URL=https://ilven-auth.home-warlock.com/auth

ILVEN_AUTH_MODE=oidc
ILVEN_OIDC_ISSUER=${ILVEN_AUTH_URL}/realms/ilven
ILVEN_OIDC_JWKS_URL=http://keycloak:8080/auth/realms/ilven/protocol/openid-connect/certs
ILVEN_OIDC_CLIENT_ID=ilven-web

CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
ILVEN_ADMIN_EMAILS=

# Pilot: OpenAI image model (gpt-image-1 was shut down on 2026-10-23). Alternative: gpt-image-2.5-flare
PILOT_OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
