# Ilven deployment settings. Copy to .env (untracked) and keep only what you change.
# Not needed for local dev: with no .env, `docker compose up` runs the platform + Keycloak on http://localhost:8080.
# No secrets here: all secrets are generated inside the stack on first start.

# --- Compose files ----------------------------------------------------------------------------------------
# Default (unset): compose.yaml + compose.override.yaml (dev: Keycloak, e2e test service).
# Grant container management to Nevli (optional, root-equivalent docker.sock through a locked-down proxy):
# COMPOSE_FILE=compose.yaml:compose.override.yaml:compose.docker.yaml
# Production with Cloudflare Access (no Keycloak):
# COMPOSE_FILE=compose.yaml
# Integrations living in other repositories (e.g. Locke, cloned next to this repo): create an untracked
# compose.local.yaml with `include: [../locke/compose.yaml]` and append :compose.local.yaml to COMPOSE_FILE.

# --- Local access -----------------------------------------------------------------------------------------
# ILVEN_HTTP_PORT=8080
# Local URL (also the only origin allowed to reach the Keycloak admin console).
# ILVEN_PUBLIC_URL=http://localhost:8080

# --- Public exposure (e.g. through a Cloudflare tunnel to the gateway) --------------------------------------
# Platform hosts: https://ilven-<name>.<domain>. Integrated systems keep their own name: https://<name>.<domain>.
# ILVEN_PUBLIC_DOMAIN=example.com
# ILVEN_PUBLIC_HOSTS=auth account admin pilot
# ILVEN_APP_HOSTS=locke-vault
# The single public URL of the identity provider (token issuer).
# ILVEN_AUTH_URL=https://ilven-auth.example.com/auth

# --- Identity --------------------------------------------------------------------------------------------
# oidc (Keycloak, default) or cloudflare (Cloudflare Access).
# ILVEN_AUTH_MODE=oidc
# Defaults derive from ILVEN_AUTH_URL and the bundled Keycloak:
# ILVEN_OIDC_ISSUER=https://ilven-auth.example.com/auth/realms/ilven
# ILVEN_OIDC_JWKS_URL=http://keycloak:8080/auth/realms/ilven/protocol/openid-connect/certs
# ILVEN_OIDC_CLIENT_ID=ilven-web
# Cloudflare mode:
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=
# ILVEN_ADMIN_EMAILS=admin@example.com

# --- Apps --------------------------------------------------------------------------------------------------
# Pilot: OpenAI image model. Alternative: gpt-image-2.5-flare
# PILOT_OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Locke-Vault: per-user quota (bytes) and extra read-only data sources (JSON list of {id, url}).
# VAULT_QUOTA_BYTES=268435456
# VAULT_SOURCES=[{"id":"pilot","url":"http://app-pilot:8080/apps/pilot/api/vault-source"}]

# --- e2e (optional): run the real-LLM / real-OpenAI checks -------------------------------------------------
# E2E_ANTHROPIC_API_KEY=
# E2E_OPENAI_API_KEY=
